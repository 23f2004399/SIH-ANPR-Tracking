# ZyroTrace AI - Frontend Configuration

# FastAPI Backend URL (proxied via Next.js rewrites)
BACKEND_URL=http://127.0.0.1:8000

# Optional: CartoDB API Key for Positron Grayscale Tiles
# Get a key at: https://carto.com/basemaps/
# If left empty, official high-resolution OpenStreetMap tiles are used with zero watermark!
NEXT_PUBLIC_CARTO_API_KEY=

# Optional: Custom Map Tile URL Template (defaults to OpenStreetMap)
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
